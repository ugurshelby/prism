{
  "name": "prism",
  "productName": "Prism",
  "version": "2.2.0",
  "private": true,
  "description": "Desktop widget that turns rough prompts into model-specific prompts for Claude, GPT, Gemini and Grok, with your own API keys.",
  "author": {
    "name": "ugurshelby",
    "email": "222421934+ugurshelby@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://ugurshelby.github.io/prism/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugurshelby/prism.git"
  },
  "bugs": {
    "url": "https://github.com/ugurshelby/prism/issues"
  },
  "keywords": [
    "prompt-engineering",
    "claude",
    "gpt",
    "gemini",
    "grok",
    "llm",
    "electron",
    "desktop"
  ],
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "setup": "node scripts/setup.mjs",
    "mock": "vite --config vite.mock.config.ts",
    "build": "node scripts/build-product.mjs spectrum",
    "build:ray": "node scripts/build-product.mjs ray",
    "build:spectrum": "node scripts/build-product.mjs spectrum",
    "start": "electron-vite preview",
    "selftest": "electron-vite build && electron . --selftest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint src scripts electron.vite.config.ts vite.mock.config.ts vitest.config.mts",
    "test": "vitest run",
    "precommit": "npm run -s lint && npm run -s typecheck && npm run -s test",
    "icons": "node scripts/make-icons.mjs",
    "dist:ray": "node scripts/build-product.mjs ray --dist",
    "dist:spectrum": "node scripts/build-product.mjs spectrum --dist"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint-plugin-security": "^4.2.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
