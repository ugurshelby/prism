{
  "name": "prism",
  "productName": "Prism",
  "version": "2.1.0",
  "private": true,
  "description": "Desktop widget that turns rough prompts into model-specific prompts for Claude, GPT, Gemini and Grok, with your own API keys.",
  "author": {
    "name": "ugurshelby",
    "email": "222421934+ugurshelby@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://ugurshelby.github.io/prism/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugurshelby/prism.git"
  },
  "bugs": {
    "url": "https://github.com/ugurshelby/prism/issues"
  },
  "keywords": [
    "prompt-engineering",
    "claude",
    "gpt",
    "gemini",
    "grok",
    "llm",
    "electron",
    "desktop"
  ],
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "setup": "node scripts/setup.mjs",
    "mock": "vite --config vite.mock.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "selftest": "electron-vite build && electron . --selftest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
