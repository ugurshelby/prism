{
  "name": "prompter",
  "productName": "Prompter",
  "version": "2.0.0",
  "private": true,
  "description": "Ham promptu analiz edip Claude, GPT, Gemini ya da Grok için doğru model ve effort seviyesine göre optimize eden masaüstü widget'ı.",
  "author": "ts",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "setup": "node scripts/setup.mjs",
    "mock": "vite --config vite.mock.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "selftest": "electron-vite build && electron . --selftest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
