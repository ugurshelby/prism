---
import Base from '../layouts/Base.astro'
import { href } from '../lib/site'
import { t } from '../lib/i18n'
const s = t('en')
---

<!-- Eski adres: bağlantılar kırılmasın diye yalnızca yeni sayfaya yönlendirir. -->
<Base lang="en" page="versions" title={s.nav.products} description={s.products.lead}>
  <section class="hero">
    <div class="container">
      <p class="lead">{s.products.page.moved} <a class="text-link" href={href('en', 'products')}>{s.nav.products} →</a></p>
    </div>
  </section>
</Base>
