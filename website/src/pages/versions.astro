---
import Base from '../layouts/Base.astro'
import { href } from '../lib/site'
import { s } from '../lib/copy'
---

<!-- Old address: only points to the new page so existing links keep working. -->
<Base page="versions" title={s.nav.products} description={s.products.lead}>
  <section class="hero">
    <div class="container">
      <p class="lead">{s.products.page.moved} <a class="text-link" href={href('products')}>{s.nav.products} →</a></p>
    </div>
  </section>
</Base>
