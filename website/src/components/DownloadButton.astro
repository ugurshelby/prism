---
import Icon from './Icon.astro'
import { files, href, latest } from '../lib/site'
import { s } from '../lib/copy'

const f = files(latest)
const page = href('download')
---

<a
  class="btn btn-primary"
  data-dl
  href={page}
  data-win={f.win?.url}
  data-mac-arm={f.macArm?.url}
  data-mac-intel={f.macIntel?.url}
  data-linux={`${page}?os=linux`}
  data-label-win={s.cta.downloadFor('Windows')}
  data-label-mac-arm={s.cta.downloadFor('macOS')}
  data-label-mac-intel={s.cta.downloadFor('macOS (Intel)')}
  data-label-linux={s.cta.downloadFor('Linux')}
>
  <Icon name="download" size={20} />
  <span data-label>{s.cta.download}</span>
  {latest && <small>v{latest.version}</small>}
</a>

<script>
  import '../scripts/detect'
</script>
