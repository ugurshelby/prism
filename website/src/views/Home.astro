---
import Base from '../layouts/Base.astro'
import DownloadButton from '../components/DownloadButton.astro'
import ProductCard from '../components/ProductCard.astro'
import Icon from '../components/Icon.astro'
import { PRODUCTS, REPO, asset, href } from '../lib/site'
import { s } from '../lib/copy'

const shots = ['compose', 'review', 'result']
const families = [
  { name: 'Claude', hue: 'var(--claude)', models: ['Fable 5.1', 'Opus 5.5', 'Sonnet 5.5', 'Haiku 5.5'], where: 'Claude Code · claude.ai · API' },
  { name: 'GPT', hue: 'var(--gpt)', models: ['GPT-6 Astra', 'GPT-6.1 Sol', 'GPT-6.1 Terra', 'GPT-6 Luna'], where: 'Codex · ChatGPT · API' },
  { name: 'Gemini', hue: 'var(--gemini)', models: ['Gemini 4 Carbon', '4 Argon', '4 Hydrogen', '3.8 Flash', '3.5 Flash-Lite'], where: 'Antigravity · Gemini · API' },
  { name: 'Grok', hue: 'var(--grok)', models: ['Grok 4.7', 'Grok 4.3', 'Grok Build 0.1'], where: 'Grok Build · Grok · API' }
]
---

<Base page="">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{s.hero.eyebrow}</span>
        <h1>{s.hero.title[0]}<br /><span class="grad">{s.hero.title[1]}</span></h1>
        <p class="lead">{s.hero.lead}</p>
        <div class="actions">
          <DownloadButton />
          <a class="btn btn-ghost" href={href('download')}>{s.cta.otherPlatforms}</a>
        </div>
        <p class="note">{s.cta.free}</p>
      </div>
      <figure class="hero-visual">
        <img class="shot" src={asset('screenshots/review.png')} width="660" height="960" alt="" decoding="async" />
      </figure>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head" data-reveal><h2>{s.steps.title}</h2></div>
      <div class="grid steps">
        {
          s.steps.items.map((step, i) => (
            <div class="card step" data-reveal>
              <span class="num">0{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <figure class="step-shot">
                <img src={asset(`screenshots/${shots[i]}.png`)} width="660" height="960" alt={step.title} loading="lazy" decoding="async" />
              </figure>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{s.families.title}</h2>
        <p class="lead">{s.families.lead}</p>
      </div>
      <div class="grid grid-4">
        {
          families.map((f) => (
            <div class="card family" style={`--hue:${f.hue}`} data-reveal>
              <h3><span class="dot" />{f.name}</h3>
              <div class="chips">
                {f.models.map((m) => (
                  <span class="chip">{m}</span>
                ))}
              </div>
              <p class="muted where">{f.where}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head" data-reveal><h2>{s.features.title}</h2></div>
      <div class="grid">
        {
          s.features.items.map((f) => (
            <div class="card feature" data-reveal>
              <Icon name={f.icon} size={26} />
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
      <div class="card privacy" data-reveal>
        <Icon name="shield" size={44} />
        <div>
          <h3>{s.privacy.title}</h3>
          <p>{s.privacy.body}</p>
          <p><a class="text-link" href={`${REPO}/blob/main/SECURITY.md`}>{s.privacy.link} →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{s.products.title}</h2>
        <p class="lead">{s.products.lead}</p>
      </div>
      <div class="grid-2">
        {PRODUCTS.map((p) => <ProductCard id={p.id} name={p.name} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="container closing" data-reveal>
      <h2>{s.hero.title[1]}</h2>
      <div class="actions">
        <DownloadButton />
        <a class="btn btn-ghost" href={href('how-it-works')}>{s.nav.how} →</a>
      </div>
      <p class="note">{s.cta.free}</p>
    </div>
  </section>
</Base>
