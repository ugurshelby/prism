---
import Base from '../layouts/Base.astro'
import ProductCard from '../components/ProductCard.astro'
import { PRODUCTS } from '../lib/site'
import { s } from '../lib/copy'

---

<Base page="products" title={s.nav.products} description={s.products.lead}>
  <section class="hero">
    <div class="container">
      <div class="section-head">
        <h1>{s.products.title}</h1>
        <p class="lead">{s.products.lead}</p>
      </div>
      <div class="grid-2">
        {PRODUCTS.map((p) => <ProductCard id={p.id} name={p.name} detail />)}
      </div>
    </div>
  </section>
</Base>
