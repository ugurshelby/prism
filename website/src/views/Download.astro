---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Mark from '../components/Mark.astro'
import { CHANGES } from '../data/changes'
import { GENERATIONS, OS_PLATFORMS, REPO, date, files, latest, mb, releasesOf, sums, type Lang, type Os } from '../lib/site'
import { t } from '../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = t(lang)
const OSES: Os[] = ['win', 'mac', 'linux']

const editions = GENERATIONS.map((g) => ({
  id: g.id,
  name: g.name,
  status: g.status,
  tagline: s.editions.items[g.id].tagline,
  versions: releasesOf(g.id).map((r) => {
    const f = files(r)
    return {
      version: r.version,
      date: date(r.published, lang),
      url: r.url,
      sums: sums(r)?.url ?? null,
      changes: CHANGES[r.version]?.[lang] ?? [],
      files: Object.fromEntries(
        OSES.map((os) => [
          os,
          OS_PLATFORMS[os].flatMap((p) => (f[p] ? [{ label: s.platform[p], name: f[p]!.name, url: f[p]!.url, size: mb(f[p]!.size), sha: f[p]!.sha256 }] : []))
        ])
      )
    }
  })
}))
const data = {
  editions,
  initial: 'spectrum',
  text: {
    latest: s.download.latest,
    changes: s.download.changes('{v}'),
    changesOnGitHub: s.download.changesOnGitHub,
    released: s.download.released,
    noFiles: s.download.noFiles,
    notReleased: s.download.notReleased,
    notReleasedBody: s.download.notReleasedBody,
    noReleases: s.download.noReleases,
    checksum: s.download.checksum,
    sums: s.download.sums,
    firstLaunch: s.download.firstLaunch
  },
  steps: s.download.steps
}
const fallback = files(latest)
---

<Base lang={lang} page="download" title={s.download.title} description={s.download.lead}>
  <section class="hero">
    <div class="container">
      <div class="section-head">
        <h1>{s.download.title}</h1>
        <p class="lead">{s.download.lead}</p>
      </div>

      <div class="picker card" data-picker>
        <div class="picker-label">{s.download.edition}</div>
        <div class="tabs editions" role="tablist" aria-label={s.download.edition} data-editions>
          <span class="tab-indicator" aria-hidden="true"></span>
          {
            GENERATIONS.map((g) => (
              <button type="button" role="tab" data-edition={g.id} aria-selected={g.id === 'spectrum' ? 'true' : 'false'}>
                <span class="tab-mark">
                  <Mark variant={g.id} />
                </span>
                <span class="tab-text">
                  <b>{g.name}</b>
                  <small>{s.editions.status[g.status]}</small>
                </span>
              </button>
            ))
          }
        </div>

        <div class="picker-controls" data-controls>
          <label class="field">
            <span class="picker-label">{s.download.version}</span>
            <select data-version aria-label={s.download.version}></select>
          </label>
          <div class="field">
            <span class="picker-label">{s.download.system}</span>
            <div class="tabs os-tabs" role="tablist" aria-label={s.download.system} data-os>
              <span class="tab-indicator" aria-hidden="true"></span>
              {
                OSES.map((os) => (
                  <button type="button" role="tab" data-os-tab={os} aria-selected={os === 'win' ? 'true' : 'false'}>
                    <Icon name={os} size={18} />
                    {s.os[os]}
                    <span class="os-detected" hidden>
                      {s.download.detected}
                    </span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <div class="picker-body" data-body aria-live="polite">
          <p class="muted">{s.download.noscript}</p>
          {
            latest ? (
              <div class="dl-files">
                {(['win', 'macArm', 'macIntel', 'appimage', 'deb'] as const).map((p) =>
                  fallback[p] ? (
                    <a class="dl-file" href={fallback[p]!.url}>
                      <b>
                        <span>{s.platform[p]}</span>
                        <span class="muted">{mb(fallback[p]!.size)}</span>
                      </b>
                      <span class="mono">{fallback[p]!.name}</span>
                    </a>
                  ) : null
                )}
              </div>
            ) : (
              <p>
                {s.download.unavailable} <a class="text-link" href={`${REPO}/releases`}>{s.download.allReleases}</a>
              </p>
            )
          }
        </div>
      </div>

      <div class="callout">
        <p style="margin:0">{s.download.firstLaunchLead}</p>
        <p style="margin:8px 0 0">{s.download.upgrade}</p>
      </div>
      <p style="margin-top:20px">
        <a class="text-link" href={`${REPO}/releases`}>{s.download.allReleases} →</a>
      </p>
    </div>
  </section>
  <script type="application/json" id="dl-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  <script>
    import '../scripts/picker'
  </script>
</Base>
