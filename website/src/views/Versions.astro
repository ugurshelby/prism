---
import Base from '../layouts/Base.astro'
import Mark from '../components/Mark.astro'
import { GENERATIONS, date, genOf, href, releases, type Lang } from '../lib/site'
import { t } from '../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = t(lang)
---

<Base lang={lang} page="versions" title={s.nav.versions} description={s.generations.lead}>
  <section class="hero">
    <div class="container">
      <div class="section-head">
        <h1>{s.generations.title}</h1>
        <p class="lead">{s.generations.lead}</p>
      </div>
      <div class="grid">
        {
          GENERATIONS.map((g) => {
            const list = releases.filter((r) => genOf(r.version)?.id === g.id)
            return (
              <article id={g.id} class={`card gen ${g.status === 'current' ? 'is-current' : ''}`}>
                <div class="mark">
                  <Mark variant={g.id} />
                </div>
                <div class="gen-head">
                  <h3>Prism {g.name}</h3>
                  <span class="muted mono">{g.major}.x</span>
                  <span class={`badge ${g.status}`}>{s.generations.status[g.status]}</span>
                </div>
                <p class="tagline">{s.generations.items[g.id].tagline}</p>
                <p>{s.generations.items[g.id].body}</p>
                <ul>
                  {s.generations.features[g.id].map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                {g.status !== 'planned' && (
                  <p class="muted" style="font-size:14px">
                    {s.generations.releases}:{' '}
                    {list.length
                      ? list.map((r, i) => (
                          <>
                            {i > 0 && ', '}
                            <a class="text-link" href={r.url}>{r.version}</a> ({date(r.published, lang)})
                          </>
                        ))
                      : s.generations.noDownloads}
                  </p>
                )}
              </article>
            )
          })
        }
      </div>
      <p style="margin-top:32px">
        <a class="btn btn-primary" href={href(lang, 'download')}>{s.nav.download} →</a>
      </p>
    </div>
  </section>
</Base>
