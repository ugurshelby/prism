---
import Base from '../layouts/Base.astro'
import EditionCard from '../components/EditionCard.astro'
import { GENERATIONS, type Lang } from '../lib/site'
import { t } from '../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = t(lang)
---

<Base lang={lang} page="versions" title={s.nav.editions} description={s.editions.lead}>
  <section class="hero">
    <div class="container">
      <div class="section-head">
        <h1>{s.editions.title}</h1>
        <p class="lead">{s.editions.lead}</p>
      </div>
      <div class="grid-2">
        {GENERATIONS.map((g) => <EditionCard lang={lang} {...g} detail />)}
      </div>
    </div>
  </section>
</Base>
