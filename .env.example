# Prism — yerel ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp yalnızca kullandığın sağlayıcıları doldur.
# Key'ler Ayarlar → Sağlayıcılar bölümünden de girilebilir (işletim sisteminin şifrelemesiyle saklanır).

# Vertex AI: Gemini modelleri, global uç nokta (README → Vertex AI)
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini API)
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# xAI (Grok)
XAI_API_KEY=
